# ============================================================
# AfyaGPT — .gitignore
# Android + Kotlin + Gradle project
# ============================================================

# ------------------------------------------------------------
# 1. GRADLE BUILD OUTPUTS
#    All generated build artifacts — never commit these.
# ------------------------------------------------------------
.gradle/
build/
**/build/
out/

# Gradle wrapper jar can be committed, but caches must not
.gradle/caches/
.gradle/daemon/
.gradle/native/
.gradle/wrapper/dists/

# ------------------------------------------------------------
# 2. LOCAL CONFIGURATION — MACHINE-SPECIFIC
#    local.properties contains the SDK path for this machine.
#    Committing it would break other developers' setups.
# ------------------------------------------------------------
local.properties
local.defaults.properties

# ------------------------------------------------------------
# 3. ANDROID STUDIO / IntelliJ IDEA
#    .idea holds IDE-specific settings. Most are machine-local;
#    only a few (like .editorconfig) are safe to share.
# ------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws

# Exceptions — project-wide settings worth sharing:
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/copyright/
!.idea/dictionaries/
!.idea/runConfigurations/

# IDE-generated modules file
.idea/modules.xml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/navEditor.xml
.idea/deploymentTargetDropDown.xml
.idea/libraries/
.idea/caches/

# ------------------------------------------------------------
# 4. KOTLIN / KSP / KAPT CODE GENERATION
#    Auto-generated Room DAOs, Hilt components, etc.
# ------------------------------------------------------------
.kotlin/
**/.kotlin/
**/generated/
**/ksp/

# ------------------------------------------------------------
# 5. ANDROID NATIVE BUILDS
#    External native build (NDK, CMake) output directories.
# ------------------------------------------------------------
.externalNativeBuild/
.cxx/
*.so
*.o

# ------------------------------------------------------------
# 6. SIGNING & SECRETS — CRITICAL: NEVER COMMIT THESE
#    Keystore files contain private keys for app signing.
#    Committing them exposes the ability to publish as your app.
# ------------------------------------------------------------
*.jks
*.keystore
keystore.properties
signing.properties
secrets.properties

# API keys, credentials, service-account JSON files
**/google-services.json
**/GoogleService-Info.plist
**/*credentials*.json
**/*secret*.json
**/*api_key*.properties

# ------------------------------------------------------------
# 7. ROOM DATABASE SCHEMA
#    Exported Room schemas are useful for migration history and
#    should be committed — un-ignore them here.
# ------------------------------------------------------------
# (Schema files in app/schemas/ ARE committed for migration tracking)
!app/schemas/

# ------------------------------------------------------------
# 8. CAPTURES & PROFILING
#    Android Studio Profiler / Layout Inspector output.
# ------------------------------------------------------------
captures/
*.hprof

# ------------------------------------------------------------
# 9. TEST RESULTS & COVERAGE REPORTS
#    Generated by Gradle test tasks — not source code.
# ------------------------------------------------------------
**/test-results/
**/reports/
**/jacoco/

# ------------------------------------------------------------
# 10. macOS SYSTEM FILES
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# ------------------------------------------------------------
# 11. WINDOWS SYSTEM FILES
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------------------------------
# 12. LINUX SYSTEM FILES
# ------------------------------------------------------------
*~

# ------------------------------------------------------------
# 13. LOGS & TEMP FILES
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.bak
*.orig

# ------------------------------------------------------------
# 14. APK / AAB RELEASE ARTIFACTS
#    Built outputs — distribute through the Play Console,
#    not through version control.
# ------------------------------------------------------------
*.apk
*.aab
*.ap_
*.dex

# ------------------------------------------------------------
# 15. PROGUARD MAPPING FILES
#    Keep these OUTSIDE git and archive them separately per
#    release alongside the signed APK so stack traces can be
#    de-obfuscated in production.
# ------------------------------------------------------------
**/mapping.txt
**/seeds.txt
**/usage.txt

# ------------------------------------------------------------
# 16. PROJECT-SPECIFIC EXCLUSIONS
#    Files specific to this AfyaGPT project setup.
# ------------------------------------------------------------

# Project description folder — internal planning docs, not source code
"PROJECT DESCRPTION AND FILES"/

# Local SQLite database files (generated at runtime on the device)
*.db
*.db-shm
*.db-wal

# DataStore preference files (generated at runtime)
*.preferences_pb

# Any local backup of the Room database
afyagpt_db*
afya_gpt_preferences*
